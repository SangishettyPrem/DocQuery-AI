# Server Port
PORT=3000

# MongoDB Atlas Connection String
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/docuquery_ai?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/docuquery_ai?retryWrites=true&w=majority

# Vector Search Index name in MongoDB Atlas (default: vector_index)
VECTOR_INDEX_NAME=vector_index

# Selected AI Provider: "gemini" or "openai" (default: gemini)
AI_PROVIDER=gemini

# Google Gemini API Key (required if AI_PROVIDER=gemini)
# Get your free key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (required if AI_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here

# Allowed Origin should be comma separated
# Ex:- http://localhost:3000,http://localhost:3001
ALLOWED_ORIGINS=http://localhost:3000