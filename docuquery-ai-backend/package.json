{
  "name": "docuquery-ai-service",
  "version": "1.0.0",
  "description": "Production-ready Context-Restricted Document RAG Microservice with MongoDB Atlas Vector Search and Swagger UI",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc && tsc-alias",
    "start": "node dist/server.js",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "rag",
    "vector-search",
    "mongodb-atlas",
    "gemini",
    "openai",
    "typescript",
    "express",
    "swagger"
  ],
  "author": "Prem Kumar",
  "license": "MIT",
  "dependencies": {
    "@google/generative-ai": "^0.24.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "mongoose": "^8.9.5",
    "morgan": "^1.12.1",
    "multer": "^1.4.5-lts.1",
    "openai": "^4.85.4",
    "uuid": "^11.1.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.13.4",
    "@types/uuid": "^10.0.0",
    "tsc-alias": "^1.9.2",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
