# ==========================================
# DocuQuery AI — Master Workspace .gitignore
# ==========================================

# Dependencies (Root, Frontend, Backend)
node_modules/
*/node_modules/
**/node_modules/

# Production & Build Outputs
dist/
*/dist/
**/dist/
.next/
*/.next/
**/.next/
out/
*/out/
**/out/
build/
*/build/
**/build/

# Environment Variables & Secrets (CRITICAL: Never commit credentials to GitHub)
.env
.env.local
.env.*.local
*.env
*/.env
*/.env.local
*/.env.*.local
**/.env
**/.env.local
**/.env.*.local

# Preserve example environment templates
!.env.example
!*/.env.example
!**/.env.example

# Next.js Cache & Telemetry
.next/cache/
**/.next/cache/
*.tsbuildinfo
next-env.d.ts.local

# Debug & Execution Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# OS Specific Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# IDE & Editor Configurations
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Testing & Coverage
coverage/
*/coverage/
**/coverage/
.nyc_output/

# Temporary / Scratch Files
scratch/
tmp/
temp/
